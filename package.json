{
  "name": "game-time-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "media:sync": "node scripts/sync-remote-media.mjs",
    "media:baidu:authorize": "node --env-file-if-exists=data/baidu-media.env scripts/verify-baidu-media.mjs authorize",
    "media:baidu:verify": "node --env-file-if-exists=data/baidu-media.env scripts/verify-baidu-media.mjs verify",
    "media:baidu:deploy-worker": "node --env-file-if-exists=data/baidu-media.env scripts/deploy-baidu-worker.mjs",
    "media:baidu:deploy-esa": "node --env-file-if-exists=data/baidu-media.env scripts/deploy-baidu-esa.mjs",
    "media:faststart": "node scripts/optimize-highlight-mp4.mjs",
    "media:direct-cert": "node scripts/renew-direct-media-certificate.mjs",
    "azure:dns": "node scripts/cloudflare-azure-dns.mjs",
    "azure:sync": "zsh scripts/sync-azure-backup.zsh",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.3.0",
    "nxapi": "^1.6.1-next.254",
    "psn-api": "^2.18.1",
    "undici": "^6.28.1"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "tar": "7.5.22",
    "uuid": "^11.1.1"
  }
}
